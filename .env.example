# Easy Loan Services Chatbot Configuration
# Copy this file to .env and fill in your actual values

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# Backend Server Port
PORT=3000

# Environment (development or production)
NODE_ENV=development

# Comma-separated frontend origins allowed to call this backend
FRONTEND_URL=http://localhost:5500,https://www.easyloanservices.in,https://easyloanservices.in

# Optional: Company Contact Info for fallback responses
COMPANY_PHONE=+91-88008-38765
COMPANY_EMAIL=support@easyloanservices.in
